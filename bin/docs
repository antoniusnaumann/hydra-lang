#!/usr/bin/env python3
"""Rebuild, serve, and open the Hydra reference. Ctrl-C stops the server."""
import argparse
import errno
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import subprocess
import sys
import webbrowser

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8765, help='preferred port (default: 8765; use a free port if occupied)')
    parser.add_argument('--no-open', action='store_true', help='serve without opening a browser')
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error('port must be between 0 and 65535')

    result = subprocess.run([sys.executable, str(ROOT / 'docs/build.py')], cwd=ROOT)
    if result.returncode:
        return result.returncode

    handler = partial(SimpleHTTPRequestHandler, directory=str(ROOT / 'docs'))
    try:
        server = ThreadingHTTPServer(('127.0.0.1', args.port), handler)
    except OSError as error:
        if error.errno != errno.EADDRINUSE:
            raise
        server = ThreadingHTTPServer(('127.0.0.1', 0), handler)

    with server:
        url = f'http://127.0.0.1:{server.server_port}/'
        print(f'Hydra docs: {url}\nPress Ctrl-C to stop.', flush=True)
        if not args.no_open:
            try:
                if not webbrowser.open(url):
                    print('Could not open the browser; use the URL above.', file=sys.stderr)
            except webbrowser.Error as error:
                print(f'Could not open the browser: {error}', file=sys.stderr)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print('\nStopped.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
